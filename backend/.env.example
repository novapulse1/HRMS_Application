PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novapulse_hrms?schema=public"

# Two separate JWT secrets for strict auth realm isolation
JWT_TENANT_SECRET="novapulse_tenant_jwt_secret_development_key_987654321"
JWT_ADMIN_SECRET="novapulse_admin_jwt_secret_development_key_123456789"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:3000"

# Optional explicit initial password for super admin (if omitted, seed generates random)
SUPER_ADMIN_INITIAL_PASSWORD=

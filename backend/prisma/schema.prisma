datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LicensePlan {
  trial
  basic
  pro
  enterprise
}

enum LicenseStatus {
  active
  suspended
  expired
}

enum TenantRole {
  company_admin
  manager
  employee
}

enum EmploymentType {
  full_time
  part_time
  hourly
  contract
}

enum EmployeeStatus {
  active
  inactive
  terminated
}

enum DocumentType {
  id_proof
  offer_letter
  contract
  other
}

enum AttendanceStatus {
  present
  absent
  half_day
  on_leave
  holiday
  week_off
}

enum MarkedBy {
  self
  admin
}

enum AttendanceSource {
  web
  mobile
  biometric
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum PayType {
  monthly
  hourly
  per_day
}

enum PayrollRunStatus {
  draft
  processing
  completed
  paid
}

enum PayrollApprovalStatus {
  pending_approval
  approved
  rejected
}

enum PayslipStatus {
  generated
  paid
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum LoanStatus {
  pending
  active
  repaid
  rejected
}

enum TaxRegime {
  new_regime
  old_regime
}

enum NoticePriority {
  low
  normal
  high
  urgent
}

enum NoticeCategory {
  general
  announcement
  policy
  event
  holiday
}

model SuperAdmin {
  id                   String        @id @default(uuid())
  name                 String
  email                String        @unique
  password_hash        String
  must_change_password Boolean       @default(true)
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt
  companies_created    Company[]     @relation("SuperAdminCompanies")
  refresh_tokens       RefreshToken[]

  @@map("super_admins")
}

model Company {
  id                  String             @id @default(uuid())
  name                String
  industry            String?
  size_range          String?
  contact_person_name String?
  contact_email       String?
  contact_phone       String?
  address             String?
  license_plan        LicensePlan        @default(trial)
  license_status      LicenseStatus      @default(active)
  license_start_date  DateTime           @default(now())
  license_expiry_date DateTime
  created_by          String?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  super_admin         SuperAdmin?        @relation("SuperAdminCompanies", fields: [created_by], references: [id], onDelete: SetNull)
  users               User[]
  departments         Department[]
  designations        Designation[]
  employees           Employee[]
  documents           EmployeeDocument[]
  shifts              Shift[]
  employee_shifts     EmployeeShift[]
  holidays            Holiday[]
  attendances         Attendance[]
  leave_types         LeaveType[]
  leave_balances      LeaveBalance[]
  leave_requests      LeaveRequest[]
  leave_banks         LeaveBank[]
  salary_structures   SalaryStructure[]
  payroll_runs        PayrollRun[]
  payslips            Payslip[]
  settings            CompanySettings?
  statutory_settings  StatutorySettings?
  devices             Device[]
  tickets             Ticket[]
  loans               Loan[]
  tax_documents       TaxDocument[]
  notifications       Notification[]
  audit_logs          AuditLog[]
  notices             Notice[]

  @@map("companies")
}

model User {
  id                   String          @id @default(uuid())
  company_id           String
  employee_id          String?         @unique
  email                String          @unique
  password_hash        String
  role                 TenantRole      @default(employee)
  must_change_password Boolean         @default(true)
  is_active            Boolean         @default(true)
  last_login_at        DateTime?
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  company              Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  employee             Employee?       @relation("UserEmployee", fields: [employee_id], references: [id], onDelete: SetNull)
  refresh_tokens       RefreshToken[]
  leave_approved       LeaveRequest[]  @relation("ApprovedByUser")
  payroll_generated    PayrollRun[]    @relation("GeneratedByUser")
  payroll_approved     PayrollRun[]    @relation("ApprovedPayrollUser")
  tickets_created      Ticket[]        @relation("TicketCreator")
  tickets_assigned     Ticket[]        @relation("TicketAssignee")
  loans_approved       Loan[]          @relation("ApprovedLoanUser")
  notifications        Notification[]
  notices_authored     Notice[]        @relation("NoticeAuthor")

  @@index([company_id])
  @@map("users")
}

model RefreshToken {
  id             String      @id @default(uuid())
  user_id        String?
  super_admin_id String?
  token_hash     String      @unique
  is_revoked     Boolean     @default(false)
  expires_at     DateTime
  created_at     DateTime    @default(now())

  user           User?       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  super_admin    SuperAdmin? @relation(fields: [super_admin_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([super_admin_id])
  @@map("refresh_tokens")
}

model Department {
  id           String        @id @default(uuid())
  company_id   String
  name         String
  created_at   DateTime      @default(now())

  company      Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  designations Designation[]
  employees    Employee[]

  @@index([company_id])
  @@map("departments")
}

model Designation {
  id            String      @id @default(uuid())
  company_id    String
  department_id String?
  name          String
  created_at    DateTime    @default(now())

  company       Company     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  department    Department? @relation(fields: [department_id], references: [id], onDelete: SetNull)
  employees     Employee[]

  @@index([company_id])
  @@index([department_id])
  @@map("designations")
}

model Employee {
  id                  String             @id @default(uuid())
  company_id          String
  user_id             String?            @unique
  employee_code       String
  first_name          String
  last_name           String
  email               String
  phone               String?
  department_id       String?
  designation_id      String?
  manager_id          String?
  date_of_joining     DateTime
  employment_type     EmploymentType     @default(full_time)
  status              EmployeeStatus     @default(active)
  bank_account_number String?
  bank_ifsc           String?
  bank_name           String?
  address             String?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  company             Company            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user                User?              @relation("UserEmployee")
  department          Department?        @relation(fields: [department_id], references: [id], onDelete: SetNull)
  designation         Designation?       @relation(fields: [designation_id], references: [id], onDelete: SetNull)
  manager             Employee?          @relation("ManagerSubordinates", fields: [manager_id], references: [id], onDelete: SetNull)
  subordinates        Employee[]         @relation("ManagerSubordinates")
  documents           EmployeeDocument[]
  shifts              EmployeeShift[]
  attendances         Attendance[]
  leave_balances      LeaveBalance[]
  leave_requests      LeaveRequest[]
  leave_banks         LeaveBank[]
  salary_structures   SalaryStructure[]
  payslips            Payslip[]
  tickets             Ticket[]           @relation("TicketEmployee")
  loans               Loan[]
  tax_documents       TaxDocument[]

  @@unique([company_id, employee_code])
  @@index([company_id])
  @@index([department_id])
  @@index([manager_id])
  @@map("employees")
}

model EmployeeDocument {
  id            String       @id @default(uuid())
  employee_id   String
  company_id    String
  document_type DocumentType @default(other)
  file_url      String
  file_name     String?
  uploaded_at   DateTime     @default(now())

  employee      Employee     @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  company       Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([employee_id])
  @@index([company_id])
  @@map("employee_documents")
}

model Shift {
  id             String          @id @default(uuid())
  company_id     String
  name           String
  start_time     String
  end_time       String
  is_night_shift Boolean         @default(false)
  created_at     DateTime        @default(now())

  company        Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  assignments    EmployeeShift[]

  @@index([company_id])
  @@map("shifts")
}

model EmployeeShift {
  id             String    @id @default(uuid())
  company_id     String
  employee_id    String
  shift_id       String
  effective_from DateTime
  effective_to   DateTime?

  company        Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  employee       Employee  @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  shift          Shift     @relation(fields: [shift_id], references: [id], onDelete: Cascade)

  @@index([company_id, id])
  @@index([employee_id])
  @@index([shift_id])
  @@map("employee_shifts")
}

model Holiday {
  id                    String   @id @default(uuid())
  company_id            String
  name                  String
  date                  DateTime
  is_recurring_annually Boolean  @default(false)

  company               Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@map("holidays")
}

model Attendance {
  id             String           @id @default(uuid())
  employee_id    String
  company_id     String
  date           DateTime         @db.Date
  status         AttendanceStatus @default(present)
  check_in_time  DateTime?
  check_out_time DateTime?
  worked_hours   Float            @default(0)
  marked_by      MarkedBy         @default(self)
  source         AttendanceSource @default(web)
  device_id      String?
  created_at     DateTime         @default(now())

  employee       Employee         @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  company        Company          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  device         Device?          @relation(fields: [device_id], references: [id], onDelete: SetNull)

  @@unique([employee_id, date])
  @@index([company_id])
  @@index([employee_id])
  @@index([date])
  @@index([device_id])
  @@map("attendance")
}

model Device {
  id             String       @id @default(uuid())
  company_id     String
  name           String
  device_code    String
  ip_address     String?
  location       String?
  is_active      Boolean      @default(true)
  last_sync_at   DateTime?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  company        Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  attendances    Attendance[]

  @@unique([company_id, device_code])
  @@index([company_id, id])
  @@map("devices")
}

model LeaveType {
  id                   String         @id @default(uuid())
  company_id           String
  name                 String
  is_paid              Boolean        @default(true)
  default_annual_quota Int            @default(12)

  company              Company        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  balances             LeaveBalance[]
  requests             LeaveRequest[]

  @@unique([company_id, name])
  @@index([company_id])
  @@map("leave_types")
}

model LeaveBalance {
  id            String    @id @default(uuid())
  company_id    String
  employee_id   String
  leave_type_id String
  year          Int
  allocated     Decimal   @db.Decimal(4, 1)
  used          Decimal   @default(0) @db.Decimal(4, 1)
  remaining     Decimal   @db.Decimal(4, 1)

  company       Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  employee      Employee  @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  leave_type    LeaveType @relation(fields: [leave_type_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, leave_type_id, year])
  @@index([company_id, id])
  @@index([employee_id])
  @@index([leave_type_id])
  @@map("leave_balances")
}

model LeaveRequest {
  id            String      @id @default(uuid())
  company_id    String
  employee_id   String
  leave_type_id String
  start_date    DateTime    @db.Date
  end_date      DateTime    @db.Date
  total_days    Decimal     @db.Decimal(4, 1)
  is_half_day   Boolean     @default(false)
  reason        String
  status        LeaveStatus @default(pending)
  approved_by   String?
  approved_at   DateTime?
  applied_at    DateTime    @default(now())

  company       Company     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  employee      Employee    @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  leave_type    LeaveType   @relation(fields: [leave_type_id], references: [id], onDelete: Cascade)
  approver      User?       @relation("ApprovedByUser", fields: [approved_by], references: [id], onDelete: SetNull)

  @@index([company_id, id])
  @@index([employee_id])
  @@index([leave_type_id])
  @@map("leave_requests")
}

model LeaveBank {
  id              String    @id @default(uuid())
  company_id      String
  employee_id     String
  year            Int
  banked_days     Decimal   @default(0) @db.Decimal(4, 1)
  encashed_days   Decimal   @default(0) @db.Decimal(4, 1)
  encashed_amount Decimal   @default(0) @db.Decimal(12, 2)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  company         Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  employee        Employee  @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, year])
  @@index([company_id, id])
  @@map("leave_banks")
}

model Ticket {
  id             String         @id @default(uuid())
  company_id     String
  ticket_number  String
  employee_id    String
  created_by     String
  assigned_to    String?
  category       String
  subject        String
  description    String
  priority       TicketPriority @default(medium)
  status         TicketStatus   @default(open)
  sla_due_at     DateTime?
  resolved_at    DateTime?
  resolution     String?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  company        Company        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  employee       Employee       @relation("TicketEmployee", fields: [employee_id], references: [id], onDelete: Cascade)
  creator        User           @relation("TicketCreator", fields: [created_by], references: [id], onDelete: Cascade)
  assignee       User?          @relation("TicketAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)

  @@unique([company_id, ticket_number])
  @@index([company_id, id])
  @@index([employee_id])
  @@index([assigned_to])
  @@map("tickets")
}

model SalaryStructure {
  id             String    @id @default(uuid())
  employee_id    String
  company_id     String
  pay_type       PayType   @default(monthly)
  base_amount    Decimal   @db.Decimal(12, 2)
  effective_from DateTime
  effective_to   DateTime?
  created_at     DateTime  @default(now())

  employee       Employee  @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  company        Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([employee_id])
  @@index([company_id])
  @@map("salary_structures")
}

model StatutorySettings {
  id                  String     @id @default(uuid())
  company_id          String     @unique
  pf_enabled          Boolean    @default(true)
  pf_employee_rate    Decimal    @default(12.0) @db.Decimal(5, 2)
  pf_employer_rate    Decimal    @default(12.0) @db.Decimal(5, 2)
  pf_wage_ceiling     Decimal    @default(25000.00) @db.Decimal(12, 2)
  esi_enabled         Boolean    @default(true)
  esi_employee_rate   Decimal    @default(0.75) @db.Decimal(5, 2)
  esi_employer_rate   Decimal    @default(3.25) @db.Decimal(5, 2)
  esi_wage_ceiling    Decimal    @default(21000.00) @db.Decimal(12, 2)
  tds_enabled         Boolean    @default(true)
  default_tax_regime  TaxRegime  @default(new_regime)
  updated_at          DateTime   @updatedAt

  company             Company    @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("statutory_settings")
}

model Loan {
  id                        String      @id @default(uuid())
  company_id                String
  employee_id               String
  amount                    Decimal     @db.Decimal(12, 2)
  monthly_deduction_amount  Decimal     @db.Decimal(12, 2)
  outstanding_balance       Decimal     @db.Decimal(12, 2)
  tenure_months             Int
  status                    LoanStatus  @default(pending)
  reason                    String?
  approved_by               String?
  approved_at               DateTime?
  created_at                DateTime    @default(now())
  updated_at                DateTime    @updatedAt

  company                   Company     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  employee                  Employee    @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  approver                  User?       @relation("ApprovedLoanUser", fields: [approved_by], references: [id], onDelete: SetNull)

  @@index([company_id, id])
  @@index([employee_id])
  @@map("loans")
}

model TaxDocument {
  id             String       @id @default(uuid())
  company_id     String
  employee_id    String
  financial_year String
  document_type  String       @default("FORM_16")
  file_url       String
  metadata_json  Json?
  generated_at   DateTime     @default(now())

  company        Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([company_id, id])
  @@index([employee_id, financial_year])
  @@map("tax_documents")
}

model PayrollRun {
  id              String                @id @default(uuid())
  company_id      String
  month           Int
  year            Int
  status          PayrollRunStatus      @default(draft)
  approval_status PayrollApprovalStatus @default(pending_approval)
  approved_by     String?
  approved_at     DateTime?
  generated_by    String
  generated_at    DateTime              @default(now())

  company         Company               @relation(fields: [company_id], references: [id], onDelete: Cascade)
  generator       User                  @relation("GeneratedByUser", fields: [generated_by], references: [id])
  approver        User?                 @relation("ApprovedPayrollUser", fields: [approved_by], references: [id], onDelete: SetNull)
  payslips        Payslip[]

  @@unique([company_id, month, year])
  @@index([company_id])
  @@map("payroll_runs")
}

model Payslip {
  id                String        @id @default(uuid())
  company_id        String
  payroll_run_id    String
  employee_id       String
  gross_amount      Decimal       @db.Decimal(12, 2)
  deductions_json   Json
  net_amount        Decimal       @db.Decimal(12, 2)
  working_days      Int
  present_days      Decimal       @db.Decimal(4, 1)
  paid_leave_days   Decimal       @db.Decimal(4, 1)
  unpaid_leave_days Decimal       @db.Decimal(4, 1)
  overtime_hours    Float         @default(0)
  overtime_amount   Decimal       @default(0) @db.Decimal(12, 2)
  pdf_url           String?
  status            PayslipStatus @default(generated)
  generated_at      DateTime      @default(now())

  company           Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  payroll_run       PayrollRun    @relation(fields: [payroll_run_id], references: [id], onDelete: Cascade)
  employee          Employee      @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([payroll_run_id, employee_id])
  @@index([company_id, id])
  @@index([payroll_run_id])
  @@index([employee_id])
  @@map("payslips")
}

model CompanySettings {
  id                       String   @id @default(uuid())
  company_id               String   @unique
  working_days_json        Json     @default("[\"mon\",\"tue\",\"wed\",\"thu\",\"fri\"]")
  working_hours_start      String   @default("09:00")
  working_hours_end        String   @default("18:00")
  payroll_cycle_day        Int      @default(28)
  overtime_enabled         Boolean  @default(false)
  overtime_rate_multiplier Float    @default(1.5)
  updated_at               DateTime @updatedAt

  company                  Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  company_id String
  type       String
  title      String
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([company_id])
  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(uuid())
  company_id     String?
  user_id        String?
  action         String
  entity_type    String
  entity_id      String
  old_value_json Json?
  new_value_json Json?
  created_at     DateTime @default(now())

  company        Company? @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([entity_type, entity_id])
  @@map("audit_logs")
}

model Notice {
  id         String         @id @default(uuid())
  company_id String
  author_id  String
  title      String
  content    String         @db.Text
  category   NoticeCategory @default(general)
  priority   NoticePriority @default(normal)
  is_pinned  Boolean        @default(false)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  company    Company        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  author     User           @relation("NoticeAuthor", fields: [author_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([company_id, is_pinned])
  @@map("notices")
}
